{
    "name": "laravelplus/pwa",
    "description": "Progressive Web App support for Laravel applications.",
    "keywords": ["laravel", "pwa", "progressive-web-app", "service-worker", "push-notifications"],
    "license": "MIT",
    "authors": [
        {
            "name": "LaravelPlus",
            "email": "info@laravelplus.com"
        }
    ],
    "require": {
        "php": "^8.4",
        "ext-gd": "*",
        "illuminate/support": "^12.0",
        "illuminate/database": "^12.0",
        "illuminate/http": "^12.0",
        "illuminate/notifications": "^12.0",
        "illuminate/routing": "^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0",
        "phpunit/phpunit": "^11.0"
    },
    "suggest": {
        "minishlink/web-push": "Required for push notifications (^9.0)"
    },
    "autoload": {
        "psr-4": {
            "LaravelPlus\\Pwa\\": "src/",
            "LaravelPlus\\Pwa\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LaravelPlus\\Pwa\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "LaravelPlus\\Pwa\\PwaServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
